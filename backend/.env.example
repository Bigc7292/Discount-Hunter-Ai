# Backend Environment Variables
# Copy to .env and fill in values — NEVER commit real secrets

PORT=3001
NODE_ENV=development

# Gemini API for AI-powered discovery
GEMINI_API_KEY=

# Residential Proxy API (for geo-location testing)
# Options: Bright Data, Oxylabs, SmartProxy
RESIDENTIAL_PROXY_API_KEY=
RESIDENTIAL_PROXY_PROVIDER=brightdata

# Browser Automation
USE_HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

# Optional: Redis for caching verified codes
REDIS_URL=redis://localhost:6379

# AgentMail — merchant signup / OTP verifier inbox (server-only)
# Approved inbox: discount-hunter@agentmail.to (never personal email)
AGENTMAIL_INBOX_EMAIL=discount-hunter@agentmail.to
# Server-only API key for future OTP fetch (list_messages / search). Do not commit real keys.
AGENTMAIL_API_KEY=

# Logging
LOG_LEVEL=info

# Stripe (TEST MODE — use sk_test_ / whsec_ / price_ test IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Frontend origin for Checkout success/cancel redirects
FRONTEND_URL=http://localhost:5173

# Firebase Admin (service account JSON as a single-line string)
# Also used to persist public checkout ledger (collection: checkoutLedger)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Rate limits (requests per minute, in-memory sliding window)
RATE_LIMIT_VERIFY_PER_MIN=10
RATE_LIMIT_DISCOVER_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=10

# Verified checkout ledger — in-memory ring buffer size when Firestore unavailable
LEDGER_MEMORY_MAX=500
