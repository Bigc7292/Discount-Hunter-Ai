# Backend Environment Variables
# Copy to .env and fill in values — NEVER commit real secrets

PORT=3001
NODE_ENV=development

# Gemini API for AI-powered discovery
GEMINI_API_KEY=

# Residential Proxy API (for geo-location testing via frontend testRegion)
# Bright Data recommended. Password = API/zone password; never commit real secrets.
# Without RESIDENTIAL_PROXY_API_KEY, verify still runs on the server IP (no geo exit).
RESIDENTIAL_PROXY_API_KEY=
RESIDENTIAL_PROXY_PROVIDER=brightdata
# Bright Data customer id (optional). When set, username is:
#   brd-customer-{CUSTOMER}-zone-{ZONE}-country-{cc}-session-{session}
# When unset, backward-compatible username:
#   zone-residential-{cc}-session-{session}
RESIDENTIAL_PROXY_CUSTOMER=
RESIDENTIAL_PROXY_ZONE=residential
RESIDENTIAL_PROXY_HOST=brd.superproxy.io
RESIDENTIAL_PROXY_PORT=22225

# ── Browserless.io (primary hosted Chrome) ──────────────────────────────────
# When set, browserBot uses puppeteer.connect to Browserless instead of local Chromium.
# Bright Data geo ProxyConfig is attached via Browserless externalProxyServer
# (requires a paid Browserless plan for third-party proxies — see docs).
# Never commit real tokens.
BROWSERLESS_TOKEN=
# Alias accepted by code: BROWSERLESS_API_TOKEN=
# Optional WS base override (default: wss://production-sfo.browserless.io — BaaS v2 2026)
# BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io
# Browserless session length in ms (default 120000 = free/starter plan max; higher values need a bigger plan)
# BROWSERLESS_SESSION_TIMEOUT_MS=120000
# Built-in residential proxy country when testRegion is GLOBAL (default us)
# BROWSERLESS_DEFAULT_PROXY_COUNTRY=us

# Browser Automation (local Chromium = fallback only when BROWSERLESS_TOKEN unset)
USE_HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

# Optional: Redis for caching verified codes
REDIS_URL=redis://localhost:6379

# AgentMail — merchant signup / OTP verifier inbox (server-only)
# Approved inbox: discount-hunter@agentmail.to (never personal email)
AGENTMAIL_INBOX_EMAIL=discount-hunter@agentmail.to
# Server-only API key for future OTP fetch (list_messages / search). Do not commit real keys.
AGENTMAIL_API_KEY=

# Logging
LOG_LEVEL=info

# Stripe (TEST MODE — use sk_test_ / whsec_ / price_ test IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Frontend origin for Checkout success/cancel redirects + production CORS
# Production: set to Vercel origin (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Firebase Admin (service account JSON as a single-line string)
# Also used to persist public checkout ledger (collection: checkoutLedger)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Rate limits (requests per minute, in-memory sliding window)
RATE_LIMIT_VERIFY_PER_MIN=10
RATE_LIMIT_DISCOVER_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=10

# Verified checkout ledger — in-memory ring buffer size when Firestore unavailable
LEDGER_MEMORY_MAX=500

# ── Discovery source APIs (candidate pool only — NEVER user-facing until verify) ──
# See ../DISCOVERY_WORK_TREE.md for stage map and priority order.
# Prefer SERPER + TAVILY + Jina Reader first (Jina needs no key — r.jina.ai anonymous).
# Add SERPER_API_KEY first for widest Google coverage; then TAVILY_API_KEY.
SERPER_API_KEY=
TAVILY_API_KEY=
# Zernio social — OPTIONAL / cost-paused by default (leave empty = zero Zernio spend).
# zernioService skips when ZERNIO_API_KEY is unset; orchestrator continues via Promise.allSettled.
# Re-enable only when owner intentionally accepts Zernio cost.
ZERNIO_API_KEY=
ZERNIO_REDDIT_ACCOUNT_ID=
# Firecrawl — optional Stage D upgrade; free tier burns fast — see DISCOVERY_WORK_TREE §3a
FIRECRAWL_API_KEY=
# Optional LLM pass in codeExtractor (regex extract works without this)
NVIDIA_API_KEY=

# Agent-Reach Stage C (free multi-platform angles) — candidates only → verify gate
# https://github.com/Panniantong/Agent-Reach (MIT). Default ON; set 0 to disable.
# Zero-config on Render/Node: Exa MCP HTTP (no key). Optional CLIs when in PATH.
AGENT_REACH_ENABLED=1
# Optional: absolute path to agent-reach binary (else PATH lookup)
# AGENT_REACH_BIN=
# Exa Search API key (preferred). When set, Agent-Reach uses POST https://api.exa.ai/search
# (type=auto, contents.highlights). Without it, falls back to keyless Exa MCP HTTP.
EXA_API_KEY=
# Optional: override Exa MCP URL (default https://mcp.exa.ai/mcp?tools=web_search_exa)
# EXA_MCP_URL=
# Cookie / desktop-session platforms (Reddit/X) — OPTIONAL sidecar; leave empty on Render
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=

# ── Anti-bot / residential proxy (optional — owner supplies; never commit secrets) ──
# Prefer residential IPs for Nike/Adidas etc. Datacenter IPs (Render free) often get bot_blocked.
#
# Stack (owner locked): Browserless hosted Chrome (BROWSERLESS_TOKEN) + Bright Data geo
# (RESIDENTIAL_PROXY_*) + local Chromium fallback when Browserless unset.
#
# Geo-matched path (preferred): set RESIDENTIAL_PROXY_API_KEY (+ optional CUSTOMER/ZONE/HOST/PORT above).
# With Browserless: proxy attached via externalProxyServer=http://user:pass@host:port on the WS URL.
# Without Browserless: local Chromium --proxy-server=host:port + page.authenticate.
# Each /verify batch gets a unique -session-{id} in the username (rotating residential IP)
# while country matches the user's selected region (US→us, UK→gb, AE→ae, …).
# Singleton browser reconnects/relaunches when proxy endpoint/credentials change (US vs UK hunts).
#
# Global override (takes precedence over geo ProxyConfig):
# Passed to Chromium as --proxy-server=. Auth in URL is supported (stripped for the arg; page.authenticate used).
# Examples (placeholders only):
#   PROXY_SERVER=http://HOST:PORT
#   PROXY_SERVER=http://USER:PASS@HOST:PORT
#   PROXY_SERVER=socks5://HOST:PORT
#   RESIDENTIAL_PROXY_URL=http://USER:PASS@HOST:PORT
PROXY_SERVER=
RESIDENTIAL_PROXY_URL=
# Optional fingerprint overrides (defaults are realistic US desktop Chrome)
# BROWSER_USER_AGENT=
# BROWSER_TIMEZONE=America/New_York
