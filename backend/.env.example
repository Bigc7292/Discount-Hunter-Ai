# Backend Environment Variables
# Copy to .env and fill in values — NEVER commit real secrets

PORT=3001
NODE_ENV=development

# Gemini API for AI-powered discovery
GEMINI_API_KEY=

# Residential Proxy API (for geo-location testing)
# Options: Bright Data, Oxylabs, SmartProxy
RESIDENTIAL_PROXY_API_KEY=
RESIDENTIAL_PROXY_PROVIDER=brightdata

# Browser Automation
USE_HEADLESS_BROWSER=true
BROWSER_TIMEOUT_MS=30000

# Optional: Redis for caching verified codes
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# Stripe (TEST MODE — use sk_test_ / whsec_ / price_ test IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_YEARLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Frontend origin for Checkout success/cancel redirects
FRONTEND_URL=http://localhost:5173

# Firebase Admin (service account JSON as a single-line string)
FIREBASE_SERVICE_ACCOUNT_JSON=
