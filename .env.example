# ============================================================
# Discount Hunter AI — Frontend .env EXAMPLE
# ============================================================
# Copy to .env — NEVER commit the real .env file

# NVIDIA NIM API (free from build.nvidia.com)
VITE_NVIDIA_API_KEY=

# Backend verifier URL
VITE_VERIFIER_API_URL=http://localhost:3001

# Firebase config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe (TEST MODE publishable key — secret stays on backend)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs live on the backend (.env):
# STRIPE_YEARLY_PRICE_ID  (~$24/yr verified access)
# STRIPE_LIFETIME_PRICE_ID ($49 LTD lifetime verified access)
